PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestao
DB_USER=gestao
DB_PASSWORD=<defina-uma-senha-forte>
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<gere-um-secret-aleatorio-de-64-bytes>
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# SMTP (nodemailer)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASS=sua-senha-de-app
# SMTP_FROM=noreply@seudominio.com

# Web Push (gere com: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:admin@seudominio.com

# CSP connect-src em producao (dominios separados por virgula, ex: https://api.seudominio.com,wss://api.seudominio.com)
# CSP_CONNECT_SRC=
